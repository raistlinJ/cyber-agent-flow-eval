{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyber-agent-flow:challenge-plan:1",
  "title": "Private challenge plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "steps"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "source": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "node_id",
          "title",
          "criterion_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "node_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "criterion_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "requires": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "hints": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1500
            }
          },
          "solution": {
            "type": "string",
            "maxLength": 16000
          }
        }
      }
    }
  },
  "description": "Evaluator-only. Executable validation additionally checks criterion coverage, unique IDs and acyclic earlier-step prerequisites."
}
